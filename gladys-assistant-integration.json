  "actions": [
    {
      "key": "check",
      "label": {
        "en": "Check the forecast",
        "fr": "Vérifier la prévision",
        "de": "Vorhersage prüfen",
        "es": "Comprobar la previsión"
      },
      "description": {
        "en": "Reads SMHI now for every place, added or not, and shows what it answers.",
        "fr": "Interroge le SMHI maintenant pour chaque lieu, ajouté ou non, et affiche sa réponse.",
        "de": "Fragt SMHI jetzt für jeden Ort ab, hinzugefügt oder nicht, und zeigt die Antwort.",
        "es": "Consulta ahora el SMHI para cada lugar, añadido o no, y muestra su respuesta."
      },
      "timeout_seconds": 60
    }
  ],
  "scene_triggers": [
    {
      "key": "warning_issued",
      "label": {
        "en": "New SMHI weather warning",
        "fr": "Nouvel avertissement météo du SMHI",
        "de": "Neue SMHI-Wetterwarnung",
        "es": "Nuevo aviso meteorológico del SMHI"
      },
      "description": {
        "en": "SMHI issues a warning for a place, or raises the level of one in progress.",
        "fr": "Le SMHI émet un avertissement pour un lieu, ou relève le niveau d'un avertissement en cours.",
        "de": "SMHI gibt eine Warnung für einen Ort aus oder erhöht die Stufe einer laufenden Warnung.",
        "es": "El SMHI emite un aviso para un lugar, o eleva el nivel de uno en curso."
      },
      "fields": [
        {
          "key": "device",
