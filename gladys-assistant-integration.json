{
  "manifest_version": 1,
  "type": "device",
  "name": "SMHI",
  "description": {
    "en": "Official SMHI weather for Sweden and the Nordics: current values, forecasts, warnings.",
    "fr": "Météo officielle du SMHI, Suède et pays nordiques : mesures, prévisions, avertissements.",
    "de": "Offizielles SMHI-Wetter für Schweden und den Norden: Werte, Vorhersagen, Warnungen.",
    "es": "Tiempo oficial del SMHI para Suecia y los países nórdicos: valores, previsiones, avisos."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-smhi:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-smhi/main/cover.png",
  "categories": ["environment"],
  "transports": ["cloud"],
  "location": true,
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "SMHI forecasts",
        "fr": "Prévisions du SMHI",
        "de": "SMHI-Vorhersagen",
        "es": "Previsiones del SMHI"
      },
      "description": {
        "en": "Forecasts of the Swedish Meteorological and Hydrological Institute (SMHI) for the Nordic and Baltic countries, and its weather warnings for Sweden. Public data, no account. One device per place: each Gladys house with a location, and the coordinates entered below. Not affiliated with SMHI.",
        "fr": "Prévisions de l'Institut météorologique suédois (SMHI) pour les pays nordiques et baltes, et ses avertissements météo pour la Suède. Données publiques, sans compte. Un appareil par lieu : chaque maison localisée de Gladys, et les coordonnées saisies ci-dessous. Sans lien avec le SMHI.",
        "de": "Vorhersagen des schwedischen Wetterdienstes SMHI für die nordischen und baltischen Länder und seine Wetterwarnungen für Schweden. Öffentliche Daten, kein Konto. Ein Gerät pro Ort: jedes Haus mit Standort in Gladys und die unten eingetragenen Koordinaten. Nicht mit SMHI verbunden.",
        "es": "Previsiones del Instituto Meteorológico e Hidrológico de Suecia (SMHI) para los países nórdicos y bálticos, y sus avisos meteorológicos para Suecia. Datos públicos, sin cuenta. Un dispositivo por lugar: cada casa ubicada de Gladys y las coordenadas introducidas abajo. Sin relación con el SMHI."
      },
      "links": [
        {
          "url": "https://opendata.smhi.se/",
          "label": {
            "en": "SMHI open data",
            "fr": "Données ouvertes du SMHI",
            "de": "Offene Daten des SMHI",
            "es": "Datos abiertos del SMHI"
          }
        }
      ]
    },
    {
      "key": "use_houses",
      "type": "boolean",
      "label": {
        "en": "Forecast for the Gladys houses",
        "fr": "Prévoir pour les maisons de Gladys",
        "de": "Vorhersage für die Häuser in Gladys",
        "es": "Prever para las casas de Gladys"
      },
      "description": {
        "en": "One device per house that has a location in Gladys (Settings → Houses).",
        "fr": "Un appareil par maison localisée dans Gladys (Paramètres → Maisons).",
        "de": "Ein Gerät pro Haus mit Standort in Gladys (Einstellungen → Häuser).",
        "es": "Un dispositivo por casa ubicada en Gladys (Ajustes → Casas)."
      },
      "required": false,
      "default": true
    },
    {
      "key": "latitude",
      "type": "string",
      "label": {
        "en": "Other place: latitude",
        "fr": "Autre lieu : latitude",
        "de": "Anderer Ort: Breitengrad",
        "es": "Otro lugar: latitud"
      },
      "description": {
        "en": "Decimal degrees, a comma is accepted. Leave empty for the houses only.",
        "fr": "Degrés décimaux, la virgule est acceptée. Laissez vide pour les seules maisons.",
        "de": "Dezimalgrad, ein Komma geht auch. Leer lassen für nur die Häuser.",
        "es": "Grados decimales, se acepta la coma. Déjelo vacío para solo las casas."
      },
      "placeholder": {
        "en": "e.g. 59.3293",
        "fr": "ex. 59.3293",
        "de": "z. B. 59.3293",
        "es": "p. ej. 59.3293"
      },
      "required": false
    },
    {
      "key": "longitude",
      "type": "string",
      "label": {
        "en": "Other place: longitude",
        "fr": "Autre lieu : longitude",
        "de": "Anderer Ort: Längengrad",
        "es": "Otro lugar: longitud"
      },
      "description": {
        "en": "Decimal degrees, east positive.",
        "fr": "Degrés décimaux, positifs vers l'est.",
        "de": "Dezimalgrad, nach Osten positiv.",
        "es": "Grados decimales, positivos hacia el este."
      },
      "placeholder": {
        "en": "e.g. 18.0686",
        "fr": "ex. 18.0686",
        "de": "z. B. 18.0686",
        "es": "p. ej. 18.0686"
